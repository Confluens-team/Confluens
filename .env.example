# Copiar a .env (en la raíz del monorepo) y completar. Nunca commitear .env.
# Los valores de ejemplo corresponden a la base local de docker-compose; no son credenciales reales.

# --- Base de datos local (docker-compose.yml) ---
POSTGRES_USER=confluens
POSTGRES_PASSWORD=cambiar-en-local
POSTGRES_DB=confluens
POSTGRES_PORT=5432

# --- API (apps/api) ---
NODE_ENV=development
PORT=3000
# Conexión que usa la API en runtime. En Neon: la connection string con pooling (host con "-pooler").
DATABASE_URL=postgresql://confluens:cambiar-en-local@localhost:5432/confluens?schema=public
# Conexión directa que usa Prisma CLI para migraciones. En Neon: la connection string sin pooling.
# En local puede ser igual a DATABASE_URL.
DIRECT_URL=postgresql://confluens:cambiar-en-local@localhost:5432/confluens?schema=public
# HU-27: secreto para firmar los JWT de sesión. Obligatorio en producción (la API
# rechaza arrancar sin él); en desarrollo/test usa un fallback fijo si falta.
JWT_SECRET=
# Minutos de inactividad antes de que expire la sesión (criterio 5 de HU-27). La
# cookie se renueva en cada request autenticado, así que es una ventana deslizante.
JWT_EXPIRA_MINUTOS=120
# Origen exacto permitido por CORS para las cookies de sesión (credentials:true no
# admite origin "*"). En Vercel: la URL pública del front.
FRONTEND_URL=http://localhost:5173
# Correo saliente con Resend (ADR 0006): enlace para restablecer la contraseña y, después, HU-49.
# Vacía en desarrollo: el correo se muestra en la consola de la API. Obligatoria en producción.
RESEND_API_KEY=
# Remitente con un dominio verificado en Resend. Si queda vacío se usa onboarding@resend.dev, que
# solo puede enviar al correo del dueño de la cuenta de Resend.
CORREO_REMITENTE=

# --- Web (apps/web) --- Solo las variables con prefijo VITE_ llegan al navegador.
# URL base de la API sin /api. Vacío en desarrollo: Vite redirige /api a localhost:3000.
# En Vercel: la URL pública del servicio de Render.
VITE_API_URL=
