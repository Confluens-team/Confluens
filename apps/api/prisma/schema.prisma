// Schema de Prisma de Confluens. Implementa docs/tecnico/modelo-datos.md: cualquier cambio acá
// se acuerda con el equipo y se refleja en ese archivo (ver AGENTS.md).
// La URL de conexión se configura en prisma.config.ts.
//
// Restricciones que Prisma no expresa y viven como SQL crudo en las migraciones:
// - Evento: exclusión de solapamiento por salón (btree_gist), CHECK de horario y de salón al
//   reservar, y CHECK del tipo social (ADR 0008).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Valores literales de la máquina de estados aprobada (docs/producto/dominio.md).
enum EstadoEvento {
  EnConsulta
  Reservado
  Cobrado
  Cancelado
}

enum EstadoPresupuesto {
  Estimado
  Confirmado
  Cancelado
  Expirado
}

// Social o corporativo (ADR 0008). Las consultas sociales no pasan por el cotizador: llegan sin
// salón ni servicios y el Responsable de Eventos arma el presupuesto.
enum TipoEvento {
  Social
  Corporativo
}

enum TipoEventoSocial {
  Cumpleanos
  Casamiento
  FiestaDeQuince
  Bautismo
  FiestaCorporativa
  Otro // con detalle en Evento.tipoSocialDetalle
}

// En minúscula para coincidir con esquemaTipoJornada de @confluens/shared. Media: hasta 4 horas
// inclusive; completa: más de 4 horas.
enum TipoJornada {
  completa
  media
}

enum Rol {
  RESPONSABLE_EVENTOS
  RESPONSABLE_FINANZAS
  GERENTE_GENERAL
  ADMINISTRADOR_SISTEMA // administra el contenido público de la landing (HU-08); ve todo
  CLIENTE // definido desde el Sprint 1, se activa en el Sprint 2
}

// Credenciales. Separada de Cliente (ver modelo-datos.md).
model Usuario {
  id             Int        @id @default(autoincrement())
  email          String     @unique
  hashContrasena String
  rol            Rol
  cliente        Cliente?
  auditorias     AuditLog[]
  creadoEn       DateTime   @default(now())
  actualizadoEn  DateTime   @updatedAt
}

// Datos comerciales. Relación 1-1 opcional con Usuario: el usuario se crea recién cuando el
// cliente se registra en el canal público (Sprint 2).
model Cliente {
  id            Int         @id @default(autoincrement())
  nombre        String // nombre de la persona, o razón social si es una organización
  apellido      String? // null para razones sociales y clientes cargados antes del registro separado
  telefono      String
  correo        String
  activo        Boolean     @default(true)
  usuarioId     Int?        @unique
  usuario       Usuario?    @relation(fields: [usuarioId], references: [id])
  solicitudes   Solicitud[]
  eventos       Evento[]
  creadoEn      DateTime    @default(now())
  actualizadoEn DateTime    @updatedAt
}

// visibleEnLanding y fotoUrl son el contenido que el Administrador del Sistema publica en el canal
// público (HU-08). Nacen en true/null: los cinco salones del tarifario se publican por defecto y la
// foto se carga cuando el cliente entrega el material. La URL apunta a un hosting externo; el
// sistema no almacena archivos (ver ADR 0004).
model Salon {
  id                    Int                @id @default(autoincrement())
  nombre                String             @unique
  capacidadMaxima       Int
  superficie            Int // m²
  precioJornadaCompleta Decimal            @db.Decimal(12, 2) // sin IVA (RN-05)
  precioMediaJornada    Decimal            @db.Decimal(12, 2) // sin IVA (RN-05)
  visibleEnLanding      Boolean            @default(true)
  fotoUrl               String?
  distribuciones        Distribucion[]
  eventoSalones         EventoSalon[]
  lineasPresupuesto     LineaPresupuesto[]
  solicitudes           Solicitud[]
  creadoEn              DateTime           @default(now())
  actualizadoEn         DateTime           @updatedAt
}

// Nombre único por salón. La capacidad nunca supera la del salón (se valida en la aplicación).
model Distribucion {
  id            Int           @id @default(autoincrement())
  salonId       Int
  salon         Salon         @relation(fields: [salonId], references: [id])
  nombre        String
  capacidad     Int
  eventoSalones EventoSalon[]
  creadoEn      DateTime      @default(now())
  actualizadoEn DateTime      @updatedAt

  @@unique([salonId, nombre])
}

// categoria agrupa el catálogo tal como lo presenta el tarifario del cliente (coffee breaks,
// desayunos, degustación, lunch/cocktail, almuerzo/cena). Es nullable porque el alta de HU-02 no la
// exige: un servicio sin categoría se muestra igual, agrupado aparte.
model Servicio {
  id            Int                @id @default(autoincrement())
  nombre        String             @unique
  descripcion   String
  unidadMedida  String
  // Sin IVA (RN-05). null = "a cotizar" (HU-11): solo un tercerizado puede no tener precio fijo
  // (CHECK servicio_a_cotizar_solo_tercerizado en la migración).
  precio        Decimal?           @db.Decimal(12, 2)
  porPersona    Boolean
  tercerizado   Boolean            @default(false) // suma al total; no recibe el incremento mensual
  activo        Boolean            @default(true)
  categoria     String?
  fotoUrl       String?
  lineas        LineaPresupuesto[]
  creadoEn      DateTime           @default(now())
  actualizadoEn DateTime           @updatedAt
}

// Consulta del canal público. clienteId es nullable desde el día 1: en el Sprint 1 el formulario
// no requiere autenticación. Puede descartarse sin convertirse en evento.
// salonId es el salón que el cliente eligió en la landing antes de abrir el formulario (HU-07). Es
// una preferencia, no una reserva: no bloquea la fecha ni obliga al Responsable de Eventos a usar
// ese salón al tomar la consulta.
model Solicitud {
  id               Int      @id @default(autoincrement())
  clienteId        Int?
  cliente          Cliente? @relation(fields: [clienteId], references: [id])
  // Datos de contacto tal como los cargó el formulario.
  nombre           String
  telefono         String
  correo           String
  fechaDeseada     DateTime @db.Date
  cantidadPersonas Int // estimada
  salonId          Int?
  salon            Salon?   @relation(fields: [salonId], references: [id])
  descartada       Boolean  @default(false)
  eventoId         Int?     @unique // evento EnConsulta en el que se convirtió
  evento           Evento?  @relation(fields: [eventoId], references: [id])
  creadoEn         DateTime @default(now())
  actualizadoEn    DateTime @updatedAt
}

// En EnConsulta el salón es obligatorio; distribución e inicio/fin se completan después.
// Fuera de EnConsulta y Cancelado, inicio y fin son obligatorios (CHECK en SQL crudo).
model Evento {
  id                        Int               @id @default(autoincrement())
  clienteId                 Int
  cliente                   Cliente           @relation(fields: [clienteId], references: [id])
  fecha                     DateTime          @db.Date
  inicio                    DateTime? // horario desde
  fin                       DateTime? // horario hasta
  cantidadPersonas          Int
  estado                    EstadoEvento      @default(EnConsulta)
  tipo                      TipoEvento        @default(Corporativo)
  tipoSocial                TipoEventoSocial?
  tipoSocialDetalle         String? // qué evento es cuando tipoSocial = Otro
  // Lo que eligió el cliente. Null en los eventos anteriores: ahí la jornada sale de la línea del
  // salón del presupuesto.
  tipoJornada               TipoJornada?
  // "HH:mm", solo de referencia. El horario real (inicio/fin) se carga al agendar (ADR 0007).
  horaInicioEstimada        String?
  // Columna del Sprint 1 que quedó sin escribirse: la vigencia de los 10 días es del presupuesto y
  // no del evento (RN-06, RN-08).
  senaVenceEn               DateTime?
  // Instante en que el acumulado de pagos cruzó el 20% de la base de cobro y el salón quedó
  // reservado (HU-13). Lo escribe el módulo de pagos, no una acción manual.
  senaRegistradaEn          DateTime?
  modalidadSalonRestaurante Boolean           @default(false) // opción interna, no visible al cliente
  // Los salones que ocupa el evento, cada uno con su distribución: varios a la vez, en el mismo
  // horario (ADR 0011). Un evento Reservado o Cobrado tiene al menos uno (constraint trigger
  // evento_reservado_con_salon). Una consulta social puede no tener ninguno todavía (ADR 0008).
  salones                   EventoSalon[]
  // Notas al pie de la comanda de cocina: menús especiales, alergias, a quién buscar en el salón.
  // Las escribe el personal y solo salen en esa hoja; el cliente nunca las ve.
  observacionesComanda      String?
  solicitud                 Solicitud?
  presupuestos              Presupuesto[]
  pagos                     Pago[]
  creadoEn                  DateTime          @default(now())
  actualizadoEn             DateTime          @updatedAt
}

// Un evento puede ocupar varios salones a la vez, todos en el mismo horario: la cantidad de
// salones no cambia la duración del evento (decisión del equipo, 09/10/2026). La distribución va
// acá y no en Evento porque una distribución pertenece a un salón.
//
// inicio, fin y estado son copia de los del evento. Se duplican porque la restricción de exclusión
// que garantiza el no solapamiento (RN-12) necesita el salón y el rango horario en la misma fila,
// y acá el horario vive en Evento. Los mantiene al día un trigger sobre Evento, no la aplicación
// (ADR 0011): el estado cambia desde pagos, cancelación y modificación del presupuesto, y que cada
// uno de esos caminos tuviera que acordarse de sincronizar sería romper la garantía en silencio el
// día que se agregue uno nuevo. **No escribir estas tres columnas a mano.**
model EventoSalon {
  eventoId       Int
  evento         Evento        @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  salonId        Int
  salon          Salon         @relation(fields: [salonId], references: [id], onDelete: Restrict)
  distribucionId Int?
  distribucion   Distribucion? @relation(fields: [distribucionId], references: [id])
  inicio         DateTime? // copia de Evento, la escribe el trigger
  fin            DateTime? // copia de Evento, la escribe el trigger
  estado         EstadoEvento  @default(EnConsulta) // copia de Evento, la escribe el trigger
  creadoEn       DateTime      @default(now())

  @@id([eventoId, salonId])
  @@index([salonId])
}

// Cada evento tiene un solo presupuesto (decisión del PO, 06/10/2026): lo garantiza la aplicación,
// que crea el presupuesto junto con su evento. La relación queda de uno a muchos en el modelo.
model Presupuesto {
  id              Int                @id @default(autoincrement())
  eventoId        Int
  evento          Evento             @relation(fields: [eventoId], references: [id])
  estado          EstadoPresupuesto  @default(Estimado)
  fechaEmision    DateTime           @default(now())
  // 10 días desde la emisión o la última modificación (RN-08, HU-12). Null: presupuesto sin armar,
  // el de una consulta social que el Responsable de Eventos todavía no cargó (ADR 0008).
  venceEn         DateTime?
  total           Decimal            @db.Decimal(12, 2) // sin IVA (RN-05)
  // Lo marca el Responsable de Eventos al recibir el presupuesto. Define la base de cobro de
  // RN-01: con factura, total + IVA; sin factura, total pelado. La base no se guarda, se calcula.
  requiereFactura Boolean            @default(false)
  lineas          LineaPresupuesto[]
  creadoEn        DateTime           @default(now())
  actualizadoEn   DateTime           @updatedAt
}

// Guarda el precio unitario al emitir, no una referencia al precio actual (RN-03, HU-34).
// La línea del salón no tiene servicio: servicioId es null y la descripción la identifica.
model LineaPresupuesto {
  id             Int         @id @default(autoincrement())
  presupuestoId  Int
  presupuesto    Presupuesto @relation(fields: [presupuestoId], references: [id])
  servicioId     Int?
  servicio       Servicio?   @relation(fields: [servicioId], references: [id], onDelete: Restrict)
  descripcion    String
  cantidad       Int
  precioUnitario Decimal     @db.Decimal(12, 2) // congelado, sin IVA (RN-05)
  subtotal       Decimal     @db.Decimal(12, 2) // sin IVA (RN-05)
  // HU-11: tercerizado sin precio todavía. Va con precio y subtotal en 0, así no suma al total;
  // deja de estar a cotizar cuando el personal completa el precio.
  aCotizar       Boolean     @default(false)
  // La línea del alquiler de un salón. Las de servicio tienen servicioId, los adicionales escritos
  // a mano no tienen ninguno de los dos. Antes la del salón se identificaba como "la primera sin
  // servicio" y la jornada se sacaba parseando su descripción; con varios salones por evento hay
  // varias líneas de salón y esa convención no alcanza.
  salonId        Int?
  salon          Salon?      @relation(fields: [salonId], references: [id], onDelete: Restrict)
  // "HH:mm", opcional: a qué hora del evento se espera este servicio (un coffee a las 10:30). La
  // elige el cliente en el cotizador o el personal al armar el presupuesto. Solo la llevan los
  // servicios y los adicionales; la línea del salón no, su horario es el del evento. Mismo
  // formato que Evento.horaInicioEstimada. Si el evento ya está agendado, el servicio valida que
  // caiga entre inicio y fin; mientras está EnConsulta sin horario no hay contra qué validar.
  horaEstimada   String?
}

// Catálogo de medios de pago (Efectivo, Tarjeta, A la habitación). Baja lógica con `activo`: no se
// borra para no romper los pagos históricos que lo referencian. El ABM es del Sprint 3.
model MedioPago {
  id            Int      @id @default(autoincrement())
  nombre        String   @unique
  activo        Boolean  @default(true)
  pagos         Pago[]
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

// Cada entrega de plata del cliente contra el evento (HU-14). El acumulado define el estado del
// evento: al cruzar el 20% de la base de cobro se reserva el salón, al llegar al 100% pasa a
// Cobrado (dominio.md:21). Los pagos no se editan ni se borran.
model Pago {
  id          Int       @id @default(autoincrement())
  eventoId    Int
  evento      Evento    @relation(fields: [eventoId], references: [id])
  fecha       DateTime  @db.Date
  // OJO: a diferencia del resto de los importes del sistema, este NO es "sin IVA" (RN-05). Es la
  // plata que el cliente entregó, y se mide contra la base de cobro de RN-01, que incluye el IVA
  // cuando el presupuesto tiene requiereFactura.
  monto       Decimal   @db.Decimal(12, 2)
  medioPagoId Int
  medioPago   MedioPago @relation(fields: [medioPagoId], references: [id])
  observacion String?
  creadoEn    DateTime  @default(now())

  @@index([eventoId])
}

// Registro inmutable: nadie lo edita ni lo borra. usuarioId es null cuando actúa el Sistema (SYS).
model AuditLog {
  id            Int      @id @default(autoincrement())
  usuarioId     Int?
  usuario       Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  fecha         DateTime @default(now())
  entidad       String
  entidadId     String
  valorAnterior Json?
  valorNuevo    Json?

  @@map("audit_log")
}
