// Schema de Prisma de Confluens. Implementa docs/tecnico/modelo-datos.md: cualquier cambio acá
// se acuerda con el equipo y se refleja en ese archivo (ver AGENTS.md).
// La URL de conexión se configura en prisma.config.ts.
//
// Restricciones que Prisma no expresa y viven como SQL crudo en las migraciones:
// - Evento: exclusión de solapamiento por salón (btree_gist) y CHECK de horario al reservar.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Valores literales de la máquina de estados aprobada (docs/producto/dominio.md).
enum EstadoEvento {
  EnConsulta
  Reservado
  Cobrado
  Cancelado
}

enum EstadoPresupuesto {
  Estimado
  Confirmado
  Cancelado
  Expirado
}

enum Rol {
  RESPONSABLE_EVENTOS
  RESPONSABLE_FINANZAS
  GERENTE_GENERAL
  ADMINISTRADOR_SISTEMA // administra el contenido público de la landing (HU-08); ve todo
  CLIENTE // definido desde el Sprint 1, se activa en el Sprint 2
}

// Credenciales. Separada de Cliente (ver modelo-datos.md).
model Usuario {
  id             Int        @id @default(autoincrement())
  email          String     @unique
  hashContrasena String
  rol            Rol
  cliente        Cliente?
  auditorias     AuditLog[]
  creadoEn       DateTime   @default(now())
  actualizadoEn  DateTime   @updatedAt
}

// Datos comerciales. Relación 1-1 opcional con Usuario: el usuario se crea recién cuando el
// cliente se registra en el canal público (Sprint 2).
model Cliente {
  id            Int         @id @default(autoincrement())
  nombre        String // nombre de la persona, o razón social si es una organización
  apellido      String? // null para razones sociales y clientes cargados antes del registro separado
  telefono      String
  correo        String
  activo        Boolean     @default(true)
  usuarioId     Int?        @unique
  usuario       Usuario?    @relation(fields: [usuarioId], references: [id])
  solicitudes   Solicitud[]
  eventos       Evento[]
  creadoEn      DateTime    @default(now())
  actualizadoEn DateTime    @updatedAt
}

// visibleEnLanding y fotoUrl son el contenido que el Administrador del Sistema publica en el canal
// público (HU-08). Nacen en true/null: los cinco salones del tarifario se publican por defecto y la
// foto se carga cuando el cliente entrega el material. La URL apunta a un hosting externo; el
// sistema no almacena archivos (ver ADR 0004).
model Salon {
  id                    Int            @id @default(autoincrement())
  nombre                String         @unique
  capacidadMaxima       Int
  superficie            Int // m²
  precioJornadaCompleta Decimal        @db.Decimal(12, 2) // sin IVA (RN-05)
  precioMediaJornada    Decimal        @db.Decimal(12, 2) // sin IVA (RN-05)
  visibleEnLanding      Boolean        @default(true)
  fotoUrl               String?
  distribuciones        Distribucion[]
  eventos               Evento[]
  solicitudes           Solicitud[]
  creadoEn              DateTime       @default(now())
  actualizadoEn         DateTime       @updatedAt
}

// Nombre único por salón. La capacidad nunca supera la del salón (se valida en la aplicación).
model Distribucion {
  id            Int      @id @default(autoincrement())
  salonId       Int
  salon         Salon    @relation(fields: [salonId], references: [id])
  nombre        String
  capacidad     Int
  eventos       Evento[]
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([salonId, nombre])
}

// categoria agrupa el catálogo tal como lo presenta el tarifario del cliente (coffee breaks,
// desayunos, degustación, lunch/cocktail, almuerzo/cena). Es nullable porque el alta de HU-02 no la
// exige: un servicio sin categoría se muestra igual, agrupado aparte.
model Servicio {
  id            Int                @id @default(autoincrement())
  nombre        String             @unique
  descripcion   String
  unidadMedida  String
  precio        Decimal            @db.Decimal(12, 2) // sin IVA (RN-05)
  porPersona    Boolean
  tercerizado   Boolean            @default(false) // suma al total; no recibe el incremento mensual
  activo        Boolean            @default(true)
  categoria     String?
  fotoUrl       String?
  lineas        LineaPresupuesto[]
  creadoEn      DateTime           @default(now())
  actualizadoEn DateTime           @updatedAt
}

// Consulta del canal público. clienteId es nullable desde el día 1: en el Sprint 1 el formulario
// no requiere autenticación. Puede descartarse sin convertirse en evento.
// salonId es el salón que el cliente eligió en la landing antes de abrir el formulario (HU-07). Es
// una preferencia, no una reserva: no bloquea la fecha ni obliga al Responsable de Eventos a usar
// ese salón al tomar la consulta.
model Solicitud {
  id               Int      @id @default(autoincrement())
  clienteId        Int?
  cliente          Cliente? @relation(fields: [clienteId], references: [id])
  // Datos de contacto tal como los cargó el formulario.
  nombre           String
  telefono         String
  correo           String
  fechaDeseada     DateTime @db.Date
  cantidadPersonas Int // estimada
  salonId          Int?
  salon            Salon?   @relation(fields: [salonId], references: [id])
  descartada       Boolean  @default(false)
  eventoId         Int?     @unique // evento EnConsulta en el que se convirtió
  evento           Evento?  @relation(fields: [eventoId], references: [id])
  creadoEn         DateTime @default(now())
  actualizadoEn    DateTime @updatedAt
}

// En EnConsulta el salón es obligatorio; distribución e inicio/fin se completan después.
// Fuera de EnConsulta y Cancelado, inicio y fin son obligatorios (CHECK en SQL crudo).
model Evento {
  id                        Int           @id @default(autoincrement())
  clienteId                 Int
  cliente                   Cliente       @relation(fields: [clienteId], references: [id])
  salonId                   Int
  salon                     Salon         @relation(fields: [salonId], references: [id])
  distribucionId            Int?
  distribucion              Distribucion? @relation(fields: [distribucionId], references: [id])
  fecha                     DateTime      @db.Date
  inicio                    DateTime? // horario desde
  fin                       DateTime? // horario hasta
  cantidadPersonas          Int
  estado                    EstadoEvento  @default(EnConsulta)
  senaVenceEn               DateTime? // plazo de 10 días desde la confirmación (RN-06)
  senaRegistradaEn          DateTime? // cuándo el RE marcó la seña como cobrada
  modalidadSalonRestaurante Boolean       @default(false) // opción interna, no visible al cliente
  solicitud                 Solicitud?
  presupuestos              Presupuesto[]
  creadoEn                  DateTime      @default(now())
  actualizadoEn             DateTime      @updatedAt
}

// Un evento puede tener varios presupuestos.
model Presupuesto {
  id            Int                @id @default(autoincrement())
  eventoId      Int
  evento        Evento             @relation(fields: [eventoId], references: [id])
  estado        EstadoPresupuesto  @default(Estimado)
  fechaEmision  DateTime           @default(now())
  venceEn       DateTime // 10 días desde la emisión o la última modificación (RN-08, HU-12)
  total         Decimal            @db.Decimal(12, 2) // sin IVA (RN-05)
  lineas        LineaPresupuesto[]
  creadoEn      DateTime           @default(now())
  actualizadoEn DateTime           @updatedAt
}

// Guarda el precio unitario al emitir, no una referencia al precio actual (RN-03, HU-34).
// La línea del salón no tiene servicio: servicioId es null y la descripción la identifica.
model LineaPresupuesto {
  id             Int         @id @default(autoincrement())
  presupuestoId  Int
  presupuesto    Presupuesto @relation(fields: [presupuestoId], references: [id])
  servicioId     Int?
  servicio       Servicio?   @relation(fields: [servicioId], references: [id], onDelete: Restrict)
  descripcion    String
  cantidad       Int
  precioUnitario Decimal     @db.Decimal(12, 2) // congelado, sin IVA (RN-05)
  subtotal       Decimal     @db.Decimal(12, 2) // sin IVA (RN-05)
}

// Registro inmutable: nadie lo edita ni lo borra. usuarioId es null cuando actúa el Sistema (SYS).
model AuditLog {
  id            Int      @id @default(autoincrement())
  usuarioId     Int?
  usuario       Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  fecha         DateTime @default(now())
  entidad       String
  entidadId     String
  valorAnterior Json?
  valorNuevo    Json?

  @@map("audit_log")
}
